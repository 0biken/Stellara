# Leave both empty to run sign-in in preview mode (no account, no email).
# Set both to use Supabase Auth (Google + email magic link).
# Add <origin><basePath>/auth/callback/ to the project's redirect URL allow-list.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_PACK_PUBLIC_KEY=
NEXT_PUBLIC_ADMIN_DEMO=false

# Error monitoring (docs/md/11 §5). Leave empty to turn Sentry off entirely:
# the SDK is not downloaded and nothing is sent.
NEXT_PUBLIC_SENTRY_DSN=
# production | staging | preview | development
NEXT_PUBLIC_SENTRY_ENVIRONMENT=
# CI sets this to the commit SHA.
NEXT_PUBLIC_SENTRY_RELEASE=
