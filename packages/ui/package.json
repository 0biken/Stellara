{
  "name": "@stellara/ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./tokens.css": "./src/tokens.css",
    "./styles.css": "./src/styles.css"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "test": "vitest run",
    "storybook": "storybook dev -p 6006 --no-open --disable-telemetry",
    "storybook:build": "storybook build --disable-telemetry",
    "storybook:serve": "http-server storybook-static -a 127.0.0.1 -p 6006 --silent",
    "test:browser": "playwright test --project chromium --project webkit",
    "test:visual": "playwright test --project visual-phone --project visual-desktop"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/nunito": "5.3.0"
  },
  "devDependencies": {
    "@stellara/i18n": "workspace:*",
    "tailwindcss": "4.3.5",
    "@testing-library/react": "16.3.3",
    "axe-core": "4.14.0",
    "jsdom": "30.1.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "vitest": "5.1.0"
  }
}
