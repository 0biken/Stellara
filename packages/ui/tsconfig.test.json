{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "rootDir": ".",
    "jsx": "react-jsx",
    "module": "ESNext",
    "moduleResolution": "Bundler"
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "tests/**/*.ts",
    "tests/**/*.tsx",
    "stories/**/*.tsx",
    "browser/**/*.ts",
    "vitest.config.ts",
    "playwright.config.ts",
    ".storybook/**/*.ts",
    ".storybook/**/*.tsx"
  ]
}
