{
  "name": "stellara",
  "private": true,
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=22.13.0 <23 || >=24.0.0 <25"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "eslint apps packages scripts && node scripts/check-boundaries.mjs",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "typecheck": "turbo run typecheck",
    "test": "node --test scripts/boundaries.test.mjs scripts/check-copy.test.mjs && turbo run test",
    "storybook": "pnpm --filter @stellara/ui storybook",
    "storybook:build": "pnpm --filter @stellara/ui storybook:build",
    "test:browser": "pnpm --filter @stellara/ui test:browser",
    "test:visual": "pnpm --filter @stellara/ui test:visual",
    "check:copy": "node scripts/check-copy.mjs",
    "check:fonts": "node scripts/check-fonts.mjs",
    "report:assets": "node scripts/report-assets.mjs",
    "check:client": "node scripts/check-client.mjs",
    "supabase:prepare": "turbo run build --filter=@stellara/runtime && node apps/web/scripts/build-supabase.mjs",
    "docs:generate": "node scripts/generate-tokens.mjs && node scripts/generate-fonts.mjs && pnpm --filter stellara-docs-tools generate",
    "docs:check": "node docs/tools/check-generated.mjs"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/coverage-v8": "5.1.0",
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.65.1",
    "@storybook/addon-a11y": "10.6.7",
    "@storybook/react-vite": "10.6.7",
    "@tailwindcss/vite": "4.3.5",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/user-event": "14.6.10",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.6",
    "eslint-plugin-import-x": "4.18.1",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "fast-check": "4.10.2",
    "fontkit": "3.0.0",
    "http-server": "14.1.1",
    "prettier": "3.10.1",
    "turbo": "2.11.11",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.2",
    "storybook": "10.6.7",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  }
}
