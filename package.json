{
  "name": "stellara",
  "private": true,
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=22.13.0 <23 || >=24.0.0 <25"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "eslint apps packages scripts && node scripts/check-boundaries.mjs",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "typecheck": "turbo run typecheck",
    "test": "node --test scripts/boundaries.test.mjs && turbo run test",
    "check:client": "node scripts/check-client.mjs",
    "docs:generate": "node scripts/generate-tokens.mjs && pnpm --filter stellara-docs-tools generate",
    "docs:check": "node docs/tools/check-generated.mjs"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/coverage-v8": "5.1.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.6",
    "eslint-plugin-import-x": "4.18.1",
    "fast-check": "4.10.2",
    "prettier": "3.10.1",
    "turbo": "2.11.11",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.2",
    "vitest": "5.1.0"
  }
}
